FROM python:3.11-slim

LABEL maintainer="developer"
LABEL description="NexyHub Serial Communication — RS-232 / RS-485 / Modbus RTU (Epic 3)"
LABEL version="0.1.0"

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && mkdir -p /docker-entrypoint.d

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd

COPY sshd_config /etc/ssh/sshd_config
COPY init-ssh.sh /docker-entrypoint.d/00-ssh.sh
RUN chmod +x /docker-entrypoint.d/00-ssh.sh

ENV SSH_ENABLED=true
ENV SSH_PORT=22

COPY config.yaml /etc/nexyhub/config.yaml

EXPOSE 22

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

COPY README.md pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen --no-install-project

COPY src/ src/
RUN uv sync --no-dev --frozen

ENV PYTHONUNBUFFERED=1
ENV SSH_ROOT_PASSWORD=""
ENV SERIAL_PORT=/dev/ttyLP6
ENV BAUDRATE=9600
ENV PARITY=N
ENV STOPBITS=1
ENV SERIAL_TIMEOUT=1.0

ENTRYPOINT ["/entrypoint.sh"]
CMD ["./.venv/bin/nexyhub-serial"]
