FROM python:3.11-slim

LABEL maintainer="developer"
LABEL description="NexyHub BLE Scanner — Epic 4"
LABEL version="0.1.0"

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
    && mkdir -p /docker-entrypoint.d

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    libdbus-1-3 \
    bluez \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /var/run/sshd

COPY sshd_config /etc/ssh/sshd_config
COPY init-ssh.sh /docker-entrypoint.d/00-ssh.sh
RUN chmod +x /docker-entrypoint.d/00-ssh.sh

COPY init-ble.sh /docker-entrypoint.d/10-ble.sh
RUN chmod +x /docker-entrypoint.d/10-ble.sh

ENV SSH_ENABLED=true
ENV SSH_PORT=22

EXPOSE 22

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app

COPY README.md testing.md pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen --no-install-project

COPY src/ src/
RUN uv sync --no-dev --frozen

ENV PYTHONUNBUFFERED=1
ENV SSH_ROOT_PASSWORD=""
ENV BLE_ADAPTER=hci0
ENV BLE_SCAN_SEC=10
ENV BLE_POLL_SEC=10
ENV BLE_SHARED_DIR=/mnt/shared

ENTRYPOINT ["/entrypoint.sh"]
CMD ["./.venv/bin/nexyhub-ble"]
